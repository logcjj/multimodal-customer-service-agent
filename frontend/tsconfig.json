{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* JSX support */
    "jsx": "react-jsx",

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@parent/*": ["../src/*"]
    },

    "types": ["vite/client", "node", "@testing-library/jest-dom"]
  },
  "include": [
    "src/main.tsx",
    "src/app.tsx",
    "src/routes.tsx",
    "src/aka/**/*.ts",
    "src/aka/**/*.tsx",
    "src/custom.d.ts",
    "src/typings.d.ts",
    "externals.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/aka/**/*.test.ts",
    "src/aka/**/*.test.tsx"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
