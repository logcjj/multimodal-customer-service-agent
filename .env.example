# Copy this file to .env. Keep credentials in .env or a secret manager.

# Runtime and persistence
AKA_ROLLOUT_MODE=agent_first
AKA_DATABASE_URL=
AKA_MODEL_SECRET_KEY=
AKA_OFFLINE_INDEX_MODE=on
AKA_IMAGE_CHUNK_RETRIEVAL=on
AKA_OCR_PIPELINE=on
AKA_CAPTION_EMBEDDING=on
AKA_VERIFIED_STREAMING=on
AKA_SESSION_MEMORY=on
AKA_ENHANCED_VERIFIER=on
AKA_SESSION_TTL_SECONDS=604800
AKA_DYNAMIC_ROUTING=on
AKA_CONVERSATION_HISTORY=on
AKA_LAYERED_MEMORY=on
AKA_GENERAL_AGENT=on
AKA_MAX_CLARIFICATION_ROUNDS=3
AKA_CONVERSATION_CONTEXT_TOKENS=6000
AKA_LEGACY_LLM_MODEL=
AKA_LEGACY_LLM_TIMEOUT_SECONDS=20

# OpenAI-compatible text model
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_ENABLE_THINKING=false

# OpenAI-compatible vision model
OPENAI_VISION_API_KEY=
OPENAI_VISION_BASE_URL=
OPENAI_VISION_MODEL=
OPENAI_VISION_MAX_TOKENS=512

# Customer-service model (optional Anthropic-compatible provider)
CUSTOMER_LLM_API_KEY=
CUSTOMER_LLM_BASE_URL=
CUSTOMER_LLM_MODEL=
CUSTOMER_LLM_PROTOCOL=anthropic
CUSTOMER_LLM_ENABLE_THINKING=false

# Legacy compatibility aliases (optional)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=

# Embedding, reranking, VLM, and OCR
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_BASE_URL=
DASHSCOPE_RERANK_BASE_URL=
ALIYUN_WORKSPACE_ID=
ALIYUN_EMBEDDING_MODEL=
ALIYUN_RERANK_MODEL=
ALIYUN_VLM_MODEL=
ALIYUN_OCR_MODEL=

# Additional compatibility providers (optional)
CODING_OPENAI_API_KEY=
CODING_VISION_API_KEY=
CODING_OPENAI_BASE_URL=
CODING_ANTHROPIC_BASE_URL=
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=

BACKEND_PORT=8002
FRONTEND_PORT=5175
